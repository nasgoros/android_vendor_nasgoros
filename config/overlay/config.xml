<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-FileCopyrightText: The nasgorOS Project
     SPDX-License-Identifier: Apache-2.0

     Installed as /product/overlay/config/config.xml (OverlayConfigParser).

     LineageSetupWizard normally enables gesture navigation during setup. NasgorOS
     replaces it with silent provisioning (NasgorProvision), so the gesture overlay is
     enabled by default here instead. It stays mutable: users can still switch to
     3-button or 2-button navigation in Settings > System > Navigation.

     Devices with hardware navigation keys can ship their own product overlay config.
-->
<config>
    <overlay package="com.android.internal.systemui.navbar.gestural" enabled="true" mutable="true" />
</config>
