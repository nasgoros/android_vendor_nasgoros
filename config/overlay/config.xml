<!--
     SPDX-FileCopyrightText: The nasgorOS Project
     SPDX-License-Identifier: Apache-2.0

     Installed as /product/overlay/config/config.xml (OverlayConfigParser).

     Once this file exists, Android no longer treats android:isStatic overlays on
     /product as default-enabled: every overlay not listed here becomes mutable and
     disabled. So every static product overlay (auto-generated RROs from
     PRODUCT_PACKAGE_OVERLAYS and runtime_resource_overlay modules) is listed below,
     in their android:priority order; later entries win. The nasgoros build target
     fails if a static product overlay is missing (tools/check-overlay-config.sh).

     Gesture navigation is on by default (NasgorOS ships AOSP Provision instead of
     LineageSetupWizard, which used to enable it). It stays mutable, so users can
     still pick 3-button navigation in Settings.
-->
<config>
    <overlay package="org.lineageos.aperture.frameworksbaseoverlay" enabled="true" mutable="false" />
    <overlay package="org.lineageos.aperture.overlay.merlinx" enabled="true" mutable="false" />
