diff --git a/src/com/android/settings/deviceinfo/aboutphone/NasgorAboutHeaderPreference.java b/src/com/android/settings/deviceinfo/aboutphone/NasgorAboutHeaderPreference.java
new file mode 100644
index 0000000000..bc9abc3287
--- /dev/null
+++ b/src/com/android/settings/deviceinfo/aboutphone/NasgorAboutHeaderPreference.java
@@ -0,0 +1,266 @@
+/* SPDX-FileCopyrightText: 2026 The nasgorOS Project
+ * SPDX-License-Identifier: Apache-2.0 */
+package com.android.settings.deviceinfo.aboutphone;
+
+import android.content.Context;
+import android.content.res.Configuration;
+import android.content.res.Resources;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemProperties;
+import android.text.format.Formatter;
+import android.util.AttributeSet;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.GridLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.android.settings.R;
+
+import java.util.Locale;
+
+/** Compact, one-shot hardware overview shared by all Nasgor OS About screens. */
+public final class NasgorAboutHeaderPreference extends Preference {
+    private final Handler mMain = new Handler(Looper.getMainLooper());
+    private NasgorHardwareInfo mInfo;
+    private int mGeneration;
+
+    public NasgorAboutHeaderPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.nasgor_about_header);
+        setSelectable(false);
+        setPersistent(false);
+        setIconSpaceReserved(false);
+    }
+
+    @Override
+    public void onAttached() {
+        super.onAttached();
+        final int generation = ++mGeneration;
+        final Context app = getContext().getApplicationContext();
+        new Thread(() -> {
+            NasgorHardwareInfo result;
+            try {
+                result = NasgorHardwareInfo.read(app, null);
+            } catch (RuntimeException ignored) {
+                result = new NasgorHardwareInfo();
+            }
+            final NasgorHardwareInfo snapshot = result;
+            mMain.post(() -> {
+                if (generation != mGeneration) return;
+                mInfo = snapshot;
+                notifyChanged();
+            });
+        }, "NasgorAboutSnapshot").start();
+    }
+
+    @Override
+    public void onDetached() {
+        ++mGeneration;
+        super.onDetached();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        holder.setDividerAllowedAbove(false);
+        holder.setDividerAllowedBelow(false);
+        Context context = getContext();
+        arrangeMetrics(holder, context);
+        String version = displayVersion();
+        setText(holder, R.id.nasgor_about_version,
+                version.isEmpty() ? Build.VERSION.RELEASE : version);
+        setText(holder, R.id.nasgor_about_device, Build.MODEL);
+        String maintainer = maintainer();
+        if (maintainer.isEmpty()) {
+            try {
+                maintainer = context.getString(R.string.build_maintainer_summary).trim();
+            } catch (Resources.NotFoundException ignored) { }
+        }
+        setText(holder, R.id.nasgor_about_maintainer,
+                context.getString(R.string.nasgor_about_maintainer_value,
+                        value(maintainer, context.getString(R.string.unknown))));
+        String chipset = mInfo == null ? null : mInfo.chipset;
+        if (chipset == null || chipset.isEmpty()) {
+            chipset = Build.UNKNOWN.equals(Build.SOC_MODEL) ? Build.HARDWARE : Build.SOC_MODEL;
+        }
+        setText(holder, R.id.nasgor_about_chipset,
+                context.getString(R.string.nasgor_about_chipset_value, chipset));
+        String unavailable = context.getString(mInfo == null
+                ? R.string.nasgor_about_loading : R.string.unknown);
+        NasgorHardwareInfo info = mInfo == null ? new NasgorHardwareInfo() : mInfo;
+
+        tile(holder, R.id.nasgor_card_memory, R.drawable.nasgor_about_ic_memory,
+                R.string.nasgor_about_memory_label,
+                size(context, info.memoryTotal, unavailable),
+                available(context, info.memoryTotal, info.memoryAvailable),
+                usedPercent(info.memoryTotal, info.memoryAvailable));
+        tile(holder, R.id.nasgor_card_storage, R.drawable.nasgor_about_ic_storage,
+                R.string.nasgor_about_storage_label,
+                size(context, info.storageTotal, unavailable),
+                available(context, info.storageTotal, info.storageAvailable),
+                usedPercent(info.storageTotal, info.storageAvailable));
+        tile(holder, R.id.nasgor_card_cpu, R.drawable.nasgor_about_ic_cpu,
+                R.string.nasgor_hw_cpu,
+                info.cpuCoreCount > 0 ? context.getString(R.string.nasgor_hw_cores,
+                        info.cpuCoreCount) : unavailable,
+                info.cpuClusters.isEmpty() ? maxClock(context, info.cpuMaxKhz * 1000)
+                        : clusters(context, info.cpuClusters), -1);
+        tile(holder, R.id.nasgor_card_gpu, R.drawable.nasgor_about_ic_gpu,
+                R.string.nasgor_hw_gpu, value(info.gpu, unavailable),
+                maxClock(context, info.gpuMaxHz), -1);
+
+        String zram = info.zramCapacity >= 0
+                ? Formatter.formatShortFileSize(context, info.zramCapacity) : unavailable;
+        String zramDetail = null;
+        if (info.zramCapacity >= 0) {
+            if (info.zramCapacity == 0 || Boolean.FALSE.equals(info.zramActive)) {
+                zramDetail = context.getString(R.string.nasgor_about_zram_disabled);
+            } else if (info.zramPhysical >= 0) {
+                zramDetail = context.getString(R.string.nasgor_about_zram_physical,
+                        Formatter.formatShortFileSize(context, info.zramPhysical));
+            } else {
+                zramDetail = context.getString(R.string.nasgor_about_zram_configured);
+            }
+        }
+        tile(holder, R.id.nasgor_card_zram, R.drawable.nasgor_about_ic_zram,
+                R.string.nasgor_about_zram_label, zram, zramDetail, -1);
+        tile(holder, R.id.nasgor_card_android, R.drawable.nasgor_about_ic_android,
+                R.string.nasgor_about_android_label, Build.VERSION.RELEASE,
+                context.getString(R.string.nasgor_about_android_detail), -1);
+        setText(holder, R.id.nasgor_about_kernel, value(info.kernel, unavailable));
+    }
+
+    private void tile(PreferenceViewHolder holder, int id, int icon, int label,
+            String value, String detail, int percent) {
+        View tile = holder.findViewById(id);
+        ((ImageView) tile.findViewById(R.id.nasgor_spec_icon)).setImageResource(icon);
+        ((TextView) tile.findViewById(R.id.nasgor_spec_label)).setText(label);
+        ((TextView) tile.findViewById(R.id.nasgor_spec_value)).setText(value);
+        TextView summary = tile.findViewById(R.id.nasgor_spec_detail);
+        summary.setText(detail);
+        summary.setVisibility(detail == null || detail.isEmpty() ? View.GONE : View.VISIBLE);
+        ProgressBar meter = tile.findViewById(R.id.nasgor_spec_meter);
+        meter.setVisibility(percent < 0 ? View.GONE : View.VISIBLE);
+        if (percent >= 0) meter.setProgress(percent);
+    }
+
+    private static void arrangeMetrics(PreferenceViewHolder holder, Context context) {
+        Configuration configuration = context.getResources().getConfiguration();
+        int columns = configuration.screenWidthDp < 320 || configuration.fontScale >= 1.3f ? 1 : 2;
+        // Give the name full width at large font sizes instead of splitting letters.
+        LinearLayout brand = (LinearLayout) holder.findViewById(R.id.nasgor_about_brand_row);
+        brand.setOrientation(columns == 1 ? LinearLayout.VERTICAL : LinearLayout.HORIZONTAL);
+        View brandText = holder.findViewById(R.id.nasgor_about_brand_text);
+        LinearLayout.LayoutParams textParams = new LinearLayout.LayoutParams(
+                columns == 1 ? ViewGroup.LayoutParams.MATCH_PARENT : 0,
+                ViewGroup.LayoutParams.WRAP_CONTENT, columns == 1 ? 0 : 1);
+        int brandGap = Math.round(12 * context.getResources().getDisplayMetrics().density);
+        textParams.topMargin = columns == 1 ? brandGap : 0;
+        brandText.setLayoutParams(textParams);
+        View logo = holder.findViewById(R.id.nasgor_about_logo);
+        LinearLayout.LayoutParams logoParams = (LinearLayout.LayoutParams) logo.getLayoutParams();
+        logoParams.setMarginEnd(columns == 1 ? 0 : brandGap);
+        logo.setLayoutParams(logoParams);
+        GridLayout metrics = (GridLayout) holder.findViewById(R.id.nasgor_about_metrics);
+        // Remove old explicit specs before reducing the number of columns on a reused view.
+        for (int i = 0; i < metrics.getChildCount(); i++) {
+            metrics.getChildAt(i).setLayoutParams(new GridLayout.LayoutParams());
+        }
+        metrics.setColumnCount(columns);
+        int gap = Math.round(8 * context.getResources().getDisplayMetrics().density);
+        for (int i = 0; i < metrics.getChildCount(); i++) {
+            int column = i % columns;
+            GridLayout.LayoutParams params = new GridLayout.LayoutParams(
+                    GridLayout.spec(i / columns, GridLayout.FILL),
+                    GridLayout.spec(column, 1f));
+            params.width = 0;
+            params.height = ViewGroup.LayoutParams.WRAP_CONTENT;
+            params.setMarginStart(column > 0 ? gap / 2 : 0);
+            params.setMarginEnd(column < columns - 1 ? gap / 2 : 0);
+            params.topMargin = i >= columns ? gap : 0;
+            metrics.getChildAt(i).setLayoutParams(params);
+        }
+    }
+
+    private static String available(Context context, long total, long available) {
+        return total > 0 && available >= 0 ? context.getString(R.string.nasgor_about_available,
+                Formatter.formatShortFileSize(context, available)) : null;
+    }
+
+    private static String size(Context context, long bytes, String fallback) {
+        return bytes > 0 ? Formatter.formatShortFileSize(context, bytes) : fallback;
+    }
+
+    private static String maxClock(Context context, long hz) {
+        if (hz <= 0) return context.getString(R.string.nasgor_about_clock_unavailable);
+        String clock = hz >= 1_000_000_000L
+                ? String.format(Locale.getDefault(), "%.2f GHz", hz / 1_000_000_000.0)
+                : String.format(Locale.getDefault(), "%.0f MHz", hz / 1_000_000.0);
+        return context.getString(R.string.nasgor_about_max_clock, clock);
+    }
+
+    /** One line per frequency cluster, e.g. "2× 2.0 GHz · Performance". */
+    private static String clusters(Context context, java.util.List<long[]> clusters) {
+        StringBuilder text = new StringBuilder();
+        for (int i = 0; i < clusters.size(); i++) {
+            long[] cluster = clusters.get(i);
+            String line = context.getString(R.string.nasgor_about_cpu_cluster, cluster[0],
+                    ghz(cluster[1]));
+            int role = coreRole(i, clusters.size());
+            if (role != 0) line = line + " · " + context.getString(role);
+            if (text.length() > 0) text.append('\n');
+            text.append(line);
+        }
+        return text.toString();
+    }
+
+    /** Fastest cluster first: one cluster has no role, the slowest is efficiency. */
+    private static int coreRole(int index, int count) {
+        if (count < 2) return 0;
+        if (index == count - 1) return R.string.nasgor_about_core_efficiency;
+        if (count >= 3 && index == 0) return R.string.nasgor_about_core_prime;
+        return R.string.nasgor_about_core_performance;
+    }
+
+    /** 2000000 kHz -> "2.0 GHz", 2050000 kHz -> "2.05 GHz", 850000 kHz -> "850 MHz". */
+    private static String ghz(long khz) {
+        if (khz < 1_000_000) {
+            return String.format(Locale.getDefault(), "%d MHz", Math.round(khz / 1000.0));
+        }
+        String value = String.format(Locale.getDefault(), "%.2f", khz / 1_000_000.0);
+        if (value.endsWith("0")) value = value.substring(0, value.length() - 1);
+        return value + " GHz";
+    }
+
+    private static int usedPercent(long total, long available) {
+        if (total <= 0 || available < 0) return -1;
+        return (int) Math.round(100.0 * (1 - Math.min(total, available) / (double) total));
+    }
+
+    private static String value(String value, String fallback) {
+        return value == null || value.isEmpty() ? fallback : value;
+    }
+
+    /** Product properties cannot contain spaces; join version and codename for display. */
+    public static String displayVersion() {
+        String version = SystemProperties.get("ro.nasgoros.display.version", "");
+        String codename = SystemProperties.get("ro.nasgoros.codename", "");
+        return codename.isEmpty() || version.isEmpty() ? version : version + " " + codename;
+    }
+
+    public static String maintainer() {
+        return SystemProperties.get("ro.nasgoros.maintainer", "").replace('_', ' ').trim();
+    }
+
+    private static void setText(PreferenceViewHolder holder, int id, CharSequence text) {
+        ((TextView) holder.findViewById(id)).setText(text);
+    }
+}
