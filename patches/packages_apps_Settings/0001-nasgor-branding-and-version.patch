+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent" android:layout_height="wrap_content"
+    android:minHeight="112dp" android:orientation="vertical" android:padding="14dp"
+    android:background="@drawable/nasgor_about_tile_background">
+    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
+        android:orientation="horizontal" android:gravity="center_vertical">
+        <ImageView android:id="@+id/nasgor_spec_icon" android:layout_width="18dp"
+            android:layout_height="18dp" android:layout_marginEnd="6dp"
+            android:contentDescription="@null" android:importantForAccessibility="no" />
+        <TextView android:id="@+id/nasgor_spec_label" android:layout_width="0dp"
+            android:layout_weight="1" android:layout_height="wrap_content"
+            android:textSize="12sp" android:textColor="@color/nasgor_about_secondary" />
+    </LinearLayout>
+    <TextView android:id="@+id/nasgor_spec_value" android:layout_width="match_parent"
+        android:layout_height="wrap_content" android:layout_marginTop="8dp"
+        android:textSize="18sp" android:fontFamily="sans-serif-medium"
+        android:textColor="@color/nasgor_about_text" />
+    <TextView android:id="@+id/nasgor_spec_detail" android:layout_width="match_parent"
+        android:layout_height="wrap_content" android:layout_marginTop="4dp"
+        android:textSize="12sp" android:textColor="@color/nasgor_about_secondary" />
+    <ProgressBar android:id="@+id/nasgor_spec_meter" style="?android:attr/progressBarStyleHorizontal"
+        android:layout_width="match_parent" android:layout_height="4dp"
+        android:layout_marginTop="10dp" android:max="100" android:indeterminate="false"
+        android:progressDrawable="@drawable/nasgor_about_capacity_progress"
+        android:progressTint="@color/nasgor_about_accent"
+        android:progressBackgroundTint="@color/nasgor_about_outline"
+        android:visibility="gone" android:importantForAccessibility="no" />
+</LinearLayout>
