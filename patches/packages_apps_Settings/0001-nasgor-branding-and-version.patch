diff --git a/res/layout/nasgor_about_header.xml b/res/layout/nasgor_about_header.xml
new file mode 100644
index 0000000000..b88bbbc3ed
--- /dev/null
+++ b/res/layout/nasgor_about_header.xml
@@ -0,0 +1,79 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-FileCopyrightText: 2026 The nasgorOS Project
+     SPDX-License-Identifier: Apache-2.0 -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent" android:layout_height="wrap_content"
+    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
+    android:paddingTop="8dp" android:paddingBottom="16dp">
+    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
+        android:orientation="vertical" android:padding="16dp"
+        android:background="@drawable/nasgor_about_hero_background">
+        <LinearLayout android:id="@+id/nasgor_about_brand_row"
+            android:layout_width="match_parent" android:layout_height="wrap_content"
+            android:orientation="horizontal" android:gravity="center_vertical">
+            <ImageView android:id="@+id/nasgor_about_logo"
+                android:layout_width="104dp" android:layout_height="65dp"
+                android:layout_marginEnd="12dp" android:src="@drawable/nasgor_about_mark"
+                android:scaleType="fitCenter" android:contentDescription="@null"
+                android:importantForAccessibility="no" />
+            <LinearLayout android:id="@+id/nasgor_about_brand_text"
+                android:layout_width="0dp" android:layout_height="wrap_content"
+                android:layout_weight="1" android:orientation="vertical">
+                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
+                    android:text="@string/nasgor_about_brand" android:textSize="26sp"
+                    android:fontFamily="sans-serif-medium" android:textColor="@color/nasgor_about_text"
+                    android:accessibilityHeading="true" />
+                <TextView android:id="@+id/nasgor_about_version"
+                    android:layout_width="wrap_content" android:layout_height="wrap_content"
+                    android:layout_marginTop="6dp" android:textSize="12sp"
+                    android:background="@drawable/nasgor_about_version_background"
+                    android:paddingStart="10dp" android:paddingEnd="10dp"
+                    android:paddingTop="4dp" android:paddingBottom="4dp"
+                    android:fontFamily="sans-serif-medium" android:textColor="@color/nasgor_about_accent" />
+            </LinearLayout>
+        </LinearLayout>
+        <TextView android:id="@+id/nasgor_about_device" android:layout_width="match_parent"
+            android:layout_height="wrap_content" android:layout_marginTop="12dp"
+            android:textSize="18sp" android:fontFamily="sans-serif-medium"
+            android:textColor="@color/nasgor_about_text" />
+        <TextView android:id="@+id/nasgor_about_chipset" android:layout_width="match_parent"
+            android:layout_height="wrap_content" android:layout_marginTop="3dp"
+            android:textSize="12sp" android:textColor="@color/nasgor_about_secondary" />
+        <TextView android:id="@+id/nasgor_about_maintainer"
+            android:layout_width="wrap_content" android:layout_height="wrap_content"
+            android:layout_marginTop="10dp" android:textSize="12sp"
+            android:paddingStart="10dp" android:paddingEnd="10dp"
+            android:paddingTop="6dp" android:paddingBottom="6dp"
+            android:drawableStart="@drawable/nasgor_about_ic_maintainer"
+            android:drawablePadding="6dp"
+            android:background="@drawable/nasgor_about_version_background"
+            android:textColor="@color/nasgor_about_accent" />
+    </LinearLayout>
+    <GridLayout android:id="@+id/nasgor_about_metrics"
+        android:layout_width="match_parent" android:layout_height="wrap_content"
+        android:layout_marginTop="8dp" android:columnCount="2" android:useDefaultMargins="false">
+        <include android:id="@+id/nasgor_card_memory" layout="@layout/nasgor_about_spec_tile" />
+        <include android:id="@+id/nasgor_card_storage" layout="@layout/nasgor_about_spec_tile" />
+        <include android:id="@+id/nasgor_card_cpu" layout="@layout/nasgor_about_spec_tile" />
+        <include android:id="@+id/nasgor_card_gpu" layout="@layout/nasgor_about_spec_tile" />
+        <include android:id="@+id/nasgor_card_zram" layout="@layout/nasgor_about_spec_tile" />
+        <include android:id="@+id/nasgor_card_android" layout="@layout/nasgor_about_spec_tile" />
+    </GridLayout>
+    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
+        android:orientation="vertical" android:layout_marginTop="8dp" android:padding="14dp"
+        android:background="@drawable/nasgor_about_tile_background">
+        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
+            android:orientation="horizontal" android:gravity="center_vertical">
+            <ImageView android:layout_width="18dp" android:layout_height="18dp"
+                android:src="@drawable/nasgor_about_ic_kernel" android:layout_marginEnd="6dp"
+                android:contentDescription="@null" android:importantForAccessibility="no" />
+            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
+                android:text="@string/nasgor_about_kernel_label" android:textSize="12sp"
+                android:textColor="@color/nasgor_about_secondary" />
+        </LinearLayout>
+        <TextView android:id="@+id/nasgor_about_kernel" android:layout_width="match_parent"
+            android:layout_height="wrap_content" android:layout_marginTop="8dp"
+            android:textSize="13sp" android:fontFamily="monospace"
+            android:textColor="@color/nasgor_about_text" />
+    </LinearLayout>
+</LinearLayout>
diff --git a/res/layout/nasgor_about_spec_tile.xml b/res/layout/nasgor_about_spec_tile.xml
